# Application
APP_NAME=DocuMind
APP_HOST=127.0.0.1
APP_PORT=8000

# LLM
PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
API_KEY=ollama
MODEL=qwen3:1.7b
TEMPERATURE=0.7
MAX_TOKENS=4096

# Embeddings
OLLAMA_HOST=http://localhost:11434
EMBEDDING_MODEL=embeddinggemma:300m

# RAG
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVER_TOP_K=5

# Directories
DOCUMENTS_DIRECTORY=./data/documents
CHROMA_DIRECTORY=./data/chroma

LOG_LEVEL=INFO