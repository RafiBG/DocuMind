# APPLICATION
APP_NAME=DocuMind
APP_HOST=127.0.0.1
APP_PORT=8000

# ollama / lmstudio / cloud
PROVIDER=lmstudio

# Provider endpoints
OLLAMA_HOST=http://localhost:11434
LM_STUDIO_HOST=http://127.0.0.1:1234/v1
OPENAI_HOST=https://api.openai.com/v1

# API key for the chat provider
API_KEY=

# Chat model
MODEL=nvidia-nemotron-3.5-bolt-e4b-ud
TEMPERATURE=0.2
MAX_TOKENS=30000

SYSTEM_MESSAGE=You are DocuMind, an intelligent assistant for technical documentation. Answer questions using only the provided document context. If the answer cannot be found in the context, explicitly state that the documents do not contain sufficient information. Never invent technical specifications, procedures, values or facts.

# EMBEDDINGS
# ollama / lmstudio / cloud
EMBEDDING_PROVIDER=lmstudio

# Embedding model
EMBEDDING_MODEL=text-embedding-embeddinggemma-300m

# Optional separate API key for embeddings
# Leave empty to use the chat API key or provider default
EMBEDDING_API_KEY=

# RAG SETTINGS
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVER_TOP_K=5

# DOCUMENT STORAGE
DOCUMENTS_DIRECTORY=./data/documents
CHROMA_DIRECTORY=./data/chroma

# LOGGING
LOG_LEVEL=INFO